{
  "rules": {
    "lobbies": {
      "$lobbyId": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('hostUid').val() === auth.uid) || (data.exists() && data.child('hostUid').val() === auth.uid) || (data.exists() && !newData.exists() && data.child('hostUid').val() === auth.uid))",
        ".validate": "newData.hasChildren(['hostUid', 'hostName', 'mode', 'status', 'createdAt', 'players']) && newData.child('hostUid').isString() && newData.child('hostName').isString() && newData.child('mode').isString() && newData.child('status').isString() && newData.child('createdAt').isNumber()",
        "players": {
          "$uid": {
            ".write": "auth != null && $uid === auth.uid",
            ".validate": "newData.hasChildren(['name', 'host', 'joinedAt']) && newData.child('name').isString() && newData.child('name').val().length > 0 && newData.child('name').val().length <= 20 && newData.child('host').isBoolean() && newData.child('joinedAt').isNumber()"
          }
        }
      }
    },
    "gamePrivate": {
      "$lobbyId": {
        ".read": "auth != null && root.child('lobbies').child($lobbyId).child('hostUid').val() === auth.uid",
        ".write": "auth != null && root.child('lobbies').child($lobbyId).child('hostUid').val() === auth.uid",
        "$uid": {
          ".read": "auth != null && (auth.uid === $uid || root.child('lobbies').child($lobbyId).child('hostUid').val() === auth.uid)",
          ".write": "auth != null && root.child('lobbies').child($lobbyId).child('hostUid').val() === auth.uid",
          ".validate": "newData.hasChildren(['roleId', 'roleName', 'assignedAt']) && newData.child('roleId').isString() && newData.child('roleName').isString() && newData.child('assignedAt').isNumber()"
        }
      }
    },
    "gameActions": {
      "$lobbyId": {
        ".read": "auth != null && root.child('lobbies').child($lobbyId).child('hostUid').val() === auth.uid",
        "$actorUid": {
          ".read": "auth != null && (auth.uid === $actorUid || root.child('lobbies').child($lobbyId).child('hostUid').val() === auth.uid)",
          "$actionId": {
            ".write": "auth != null && auth.uid === $actorUid && (root.child('gamePrivate').child($lobbyId).child(auth.uid).child('roleId').val() === 'murderer' || root.child('gamePrivate').child($lobbyId).child(auth.uid).child('roleId').val() === 'sheriff') && !root.child('gameState').child($lobbyId).child('deaths').child(auth.uid).exists()",
            ".validate": "newData.hasChildren(['targetUid', 'createdAt']) && newData.child('targetUid').isString() && newData.child('createdAt').isNumber() && root.child('lobbies').child($lobbyId).child('players').child(newData.child('targetUid').val()).exists() && newData.child('targetUid').val() !== auth.uid"
          }
        }
      }
    },
    "gameNotes": {
      "$lobbyId": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['text', 'updatedAt']) && newData.child('text').isString() && newData.child('text').val().length <= 5000 && newData.child('updatedAt').isNumber()"
        }
      }
    },
    "gameState": {
      "$lobbyId": {
        "deaths": {
          ".read": "auth != null && (root.child('lobbies').child($lobbyId).child('hostUid').val() === auth.uid || root.child('lobbies').child($lobbyId).child('settings').child('mm2').child('deathVisibility').val() === 'all')",
          "$uid": {
            ".read": "auth != null && (auth.uid === $uid || root.child('lobbies').child($lobbyId).child('hostUid').val() === auth.uid || root.child('lobbies').child($lobbyId).child('settings').child('mm2').child('deathVisibility').val() === 'all')",
            ".write": "auth != null && root.child('lobbies').child($lobbyId).child('hostUid').val() === auth.uid",
            ".validate": "newData.hasChildren(['deadAt', 'killedBy', 'cause']) && newData.child('deadAt').isNumber() && newData.child('killedBy').isString() && newData.child('cause').isString()"
          }
        }
      }
    }
  }
}